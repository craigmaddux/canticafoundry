<div class="cantica cantica-card lore-card">
  <header>
    <div class="who">{{kind}}</div>
    <div class="what">{{name}}</div>
    {{#if tag}}<div class="where">{{tag}}</div>{{/if}}
  </header>
  {{#if img}}<img class="lore-img" src="{{img}}" alt="{{name}}">{{/if}}
  <div class="lore-text">{{{text}}}</div>
</div>
