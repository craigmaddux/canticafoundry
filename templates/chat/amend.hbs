<div class="cantica cantica-card amend-card">
  <header>
    <div class="who">{{actorName}}</div>
    <div class="what">{{localize "CANTICA.Card.Amends"}} <span class="dc">{{card}}</span></div>
  </header>
  <blockquote>{{trait}}</blockquote>
  {{#if note}}<p class="note">{{note}}</p>{{/if}}
  <p class="note">{{localize "CANTICA.Card.AmendNote"}}</p>
</div>
