<div class="cantica cantica-card notice-card">
  <header>
    <div class="who">{{actorName}}</div>
    <div class="what">{{localize "CANTICA.Track.Withdrew"}}</div>
  </header>
  {{#if how}}<blockquote>{{how}}</blockquote>{{/if}}
  <p class="note">{{localize "CANTICA.Track.WithdrewNote"}}</p>
  {{#if earns}}<p class="note stamp">{{localize "CANTICA.Track.WithdrewStamp"}}</p>{{/if}}
</div>
