<div class="cantica cantica-card tier-{{outcome.tier}}">
  <header>
    <div class="who">{{actorName}}</div>
    <div class="what">{{skillLabel}} <span class="dc">{{difficultyText}}</span></div>
  </header>

  <ul class="factors">
    {{#each factors}}<li>{{this}}</li>{{/each}}
  </ul>
  {{#each notes}}<p class="note">{{this}}</p>{{/each}}

  <div class="dice">
    {{#each dice}}
    <span class="die {{kind}} {{#if success}}hit{{/if}} {{flag}}" title="{{kind}}">{{value}}</span>
    {{/each}}
  </div>

  <div class="tally">
    <span class="successes">{{outcome.successes}}</span>
    <span class="vs">{{localize "CANTICA.Roll.SuccessesVs"}} {{difficulty}}</span>
  </div>

  <div class="verdict">{{tierLabel}}</div>

  {{#if outcome.grace}}
  <div class="margin grace">
    <strong>{{localize "CANTICA.Roll.Grace"}}</strong>
    <span>{{localize "CANTICA.Roll.GraceText"}}</span>
    <button type="button" data-action="claim-stamp">{{localize "CANTICA.Roll.ClaimStamp"}}</button>
  </div>
  {{/if}}

  {{#if outcome.error}}
  <div class="margin error">
    <strong>{{localize "CANTICA.Roll.Error"}}</strong>
    <span>{{localize "CANTICA.Roll.ErrorText"}}</span>
    <span class="scrutiny">{{localize "CANTICA.Roll.ScrutinyGained"}}</span>
    {{#if stampNote}}<span class="stamp">{{localize "CANTICA.Roll.StampEarned"}}</span>{{/if}}
  </div>
  {{/if}}

  {{#if resonanceLabel}}
  <div class="margin resonance">
    <strong>{{resonanceLabel}}</strong>
    <span>{{localize "CANTICA.Roll.ResonanceText"}}</span>
  </div>
  {{/if}}
</div>
