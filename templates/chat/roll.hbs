<div class="cantica cantica-card tier-{{outcome.tier}}">
  <header>
    <div class="who">{{actorName}}</div>
    <div class="what">{{skillLabel}} <span class="dc">{{difficultyText}}</span></div>
    {{#if sceneName}}<div class="where">{{localize "CANTICA.Roll.InScene"}} {{sceneName}}</div>{{/if}}
  </header>

  <ul class="factors">
    {{#each factors}}<li>{{this}}</li>{{/each}}
  </ul>
  {{#each notes}}<p class="note">{{this}}</p>{{/each}}
  {{#if encumbranceNote}}<p class="note encumbrance-note">{{encumbranceNote}}</p>{{/if}}

  <div class="dice">
    {{#each dice}}
    <span class="die {{kind}} {{#if success}}hit{{/if}} {{flag}}" title="{{kind}}">{{value}}</span>
    {{/each}}
  </div>

  <div class="tally">
    {{#if wasSuccesses}}<span class="was">{{wasSuccesses}}</span><span class="arrow">→</span>{{/if}}
    <span class="successes">{{successes}}</span>
    <span class="vs">{{localize "CANTICA.Roll.SuccessesVs"}} {{difficulty}}</span>
  </div>

  <div class="verdict">{{tierLabel}}</div>

  {{#if complication}}
  <div class="margin complication {{#if complication.negated}}negated{{/if}}">
    <strong>{{localize "CANTICA.Complication.Label"}}</strong>
    <span>{{complication.text}}</span>
  </div>
  {{/if}}

  {{#if outcome.grace}}
  <div class="margin grace">
    <strong>{{localize "CANTICA.Roll.Grace"}}</strong>
    <span>{{localize "CANTICA.Roll.GraceText"}}</span>
    <button type="button" data-action="claim-stamp">{{localize "CANTICA.Roll.ClaimStamp"}}</button>
  </div>
  {{/if}}

  {{#if outcome.error}}
  <div class="margin error">
    <strong>{{localize "CANTICA.Roll.Error"}}</strong>
    <span>{{localize "CANTICA.Roll.ErrorText"}}</span>
    <span class="scrutiny">{{localize "CANTICA.Roll.ScrutinyGained"}}</span>
    {{#if stampNote}}<span class="stamp">{{localize "CANTICA.Roll.StampEarned"}}</span>{{/if}}
  </div>
  {{/if}}

  {{#if resonanceLabel}}
  <div class="margin resonance">
    <strong>{{resonanceLabel}}</strong>
    <span>{{localize "CANTICA.Roll.ResonanceText"}}</span>
  </div>
  {{/if}}

  {{!-- The GM can complicate a roll made in a scene (one Scrutiny); the player can negate it (one Stamp).
        The chat hook shows each button only to the people it is for. --}}
  {{#if canComplicate}}
  <div class="card-actions"><button type="button" data-action="complicate" title="{{localize 'CANTICA.Complication.Hint'}}">{{localize "CANTICA.Complication.Button"}}</button></div>
  {{/if}}
  {{#if canNegate}}
  <div class="card-actions"><button type="button" data-action="negate" title="{{localize 'CANTICA.Complication.NegateHint'}}">{{localize "CANTICA.Complication.Negate"}}</button></div>
  {{/if}}
</div>
