<div class="pool-body">
  <div class="field">
    <label for="pool-skill">{{localize "CANTICA.Pool.Skill"}}</label>
    <select id="pool-skill" name="skill">
      {{#each skillGroups}}
      <optgroup label="{{label}}">
        {{#each skills}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}} ({{rating}})</option>{{/each}}
      </optgroup>
      {{/each}}
    </select>
  </div>

  <div class="field">
    <label for="pool-difficulty">{{localize "CANTICA.Pool.Difficulty"}}</label>
    <select id="pool-difficulty" name="difficulty">
      {{#if targets.length}}
      <optgroup label="{{localize 'CANTICA.Pool.Targets'}}">
        {{#each targets}}<option value="{{value}}" data-difficulty="{{rating}}" data-name="{{name}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </optgroup>
      {{/if}}
      <optgroup label="{{localize 'CANTICA.Pool.Ladder'}}">
        {{#each difficulties}}<option value="{{value}}" data-difficulty="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </optgroup>
    </select>
  </div>

  <fieldset>
    <legend>{{localize "CANTICA.Pool.Traits"}}</legend>
    {{#each traits}}
    <label class="check">
      <input type="checkbox" name="traits" value="{{key}}">
      <span class="check-label">{{label}}</span>
      <span class="check-text">{{text}}</span>
    </label>
    {{else}}
    <p class="hint">{{localize "CANTICA.Pool.NoTraits"}}</p>
    {{/each}}
    {{#if touched}}
    <label class="check gift">
      <input type="checkbox" name="gift">
      <span class="check-label">{{localize "CANTICA.Trait.gift"}}</span>
      <span class="check-text">{{#if giftText}}{{giftText}}{{else}}—{{/if}}</span>
      <span class="check-note">{{localize "CANTICA.Pool.GiftNote"}}</span>
    </label>
    {{/if}}
  </fieldset>

  {{#if commendations.length}}
  <fieldset class="commendations">
    <legend>{{localize "CANTICA.Commendation.Heading"}}</legend>
    {{#each commendations}}
    <label class="check commendation">
      <input type="checkbox" name="commendation" value="{{id}}" data-name="{{name}}" data-break="{{ruleBreak}}">
      <span class="check-label">★</span>
      <span class="check-text">{{name}}</span>
      <span class="check-note">{{#if situation}}{{situation}} · {{/if}}{{effect}}</span>
    </label>
    {{/each}}
    <p class="hint">{{localize "CANTICA.Pool.CommendationHint"}}</p>
  </fieldset>
  {{/if}}

  {{#if hasScene}}
  <fieldset class="scene">
    <legend>{{localize "CANTICA.Pool.Scene"}}</legend>
    <div class="field">
      <select name="sceneCard" aria-label="{{localize 'CANTICA.Pool.Scene'}}">
        <option value="" {{#if sceneNone}}selected{{/if}}>{{localize "CANTICA.Pool.NoScene"}}</option>
        {{#each sceneCards}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
      <p class="hint">{{sceneHint}}</p>
    </div>
    {{#each sceneCards}}
    <div class="scene-traits" data-card="{{id}}" {{#unless selected}}hidden{{/unless}}>
      {{#each traits}}
      <label class="check scene-check {{effect}}" title="{{note}}">
        <input type="checkbox" name="sceneTrait" value="{{value}}" data-name="{{name}}" data-effect="{{effect}}" {{#if checked}}checked{{/if}}>
        <span class="check-label sign">{{sign}}</span>
        <span class="check-text">{{name}}</span>
        {{#if note}}<span class="check-note">{{note}}</span>{{/if}}
      </label>
      {{else}}
      <p class="hint">{{localize "CANTICA.Pool.NoSceneTraits"}}</p>
      {{/each}}
    </div>
    {{/each}}
  </fieldset>
  {{/if}}

  <fieldset>
    <legend>{{localize "CANTICA.Pool.Environment"}}</legend>
    <div class="steppers">
      <label>{{localize "CANTICA.Pool.Circumstances"}}<input type="number" name="circumstances" value="0" min="0" max="6"></label>
      <label>{{localize "CANTICA.Pool.Obstacles"}}<input type="number" name="obstacles" value="0" min="0" max="6"></label>
      <label>{{localize "CANTICA.Pool.Bound"}}<input type="number" name="bound" value="0" min="0" max="6"></label>
    </div>
    <p class="hint">{{localize "CANTICA.Pool.EnvironmentHint"}}</p>
  </fieldset>

  <fieldset>
    <legend>{{localize "CANTICA.Stamps.Label"}}</legend>
    <label class="check {{#unless canExpedite}}off{{/unless}}">
      <input type="checkbox" name="expedite" {{#unless canExpedite}}disabled{{/unless}}>
      <span class="check-label">{{localize "CANTICA.Pool.Expedite"}}</span>
      <span class="check-text">{{stamps}} {{localize "CANTICA.Stamps.Label"}}</span>
      <span class="check-note">{{localize "CANTICA.Pool.ExpediteNote"}}</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>{{localize "CANTICA.Encumbrance.Heading"}}</legend>
    {{#each encumbrances}}
    <label class="check {{#if disabled}}off{{/if}}">
      <input type="checkbox" name="encumbrance" value="{{key}}" {{#if disabled}}disabled{{/if}}>
      <span class="check-label">{{label}}</span>
      <span class="check-text">{{#if text}}{{text}}{{else}}—{{/if}}</span>
    </label>
    {{/each}}
    <p class="hint">{{localize "CANTICA.Pool.EncumbranceNote"}}</p>
    <label class="check">
      <input type="checkbox" name="greaterBound">
      <span class="check-label">{{localize "CANTICA.Pool.GreaterBound"}}</span>
      <span class="check-note">{{localize "CANTICA.Pool.GreaterBoundNote"}}</span>
    </label>
  </fieldset>

  <div class="preview" data-preview>
    <span class="preview-total"><span data-total>1</span> {{localize "CANTICA.Pool.Dice"}}</span>
    <span class="preview-breakdown" data-breakdown></span>
    <span class="preview-note" data-note></span>
    <span class="preview-breakdown" data-error-range></span>
  </div>

  <footer>
    <button type="submit"><i class="fa-solid fa-dice-d10"></i> {{localize "CANTICA.Pool.Roll"}}</button>
  </footer>
</div>
