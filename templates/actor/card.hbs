<div class="cantica-sheet card-sheet">
  <header class="card-banner">
    <img class="banner-art" src="{{actor.img}}" alt="{{actor.name}}" {{#if isGM}}data-edit="img" data-action="editImage" title="{{localize 'CANTICA.Card.ChangeArt'}}"{{/if}}>
    <div class="banner-overlay">
      <div class="eyebrow">{{localize "CANTICA.Card.Eyebrow"}}</div>
      {{#if isGM}}
      <input class="name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'CANTICA.Card.NamePlaceholder'}}">
      {{else}}
      <div class="name name-static">{{actor.name}}</div>
      {{/if}}
      <div class="active-row">
        {{#if system.active}}<span class="badge">{{localize "CANTICA.Card.Active"}}</span>{{/if}}
        {{#if isGM}}
        <button type="button" data-action="setActive" {{#if system.active}}disabled{{/if}}>{{localize "CANTICA.Card.MakeActive"}}</button>
        <button type="button" data-action="repaintToken" title="{{localize 'CANTICA.Card.RepaintHint'}}">{{localize "CANTICA.Card.Repaint"}}</button>
        <button type="button" data-action="toggleShared" title="{{localize 'CANTICA.Share.CardHint'}}">{{#if shared}}<i class="fa-solid fa-eye-slash"></i> {{localize "CANTICA.Share.HideCard"}}{{else}}<i class="fa-solid fa-eye"></i> {{localize "CANTICA.Share.ShareCard"}}{{/if}}</button>
        {{/if}}
      </div>
    </div>
  </header>

  <div class="cantica-body card-body">
    <section class="panel description">
      <h2>{{localize "CANTICA.Card.Description"}}</h2>
      {{#if isGM}}
      <textarea name="system.description" rows="3" placeholder="{{localize 'CANTICA.Card.DescriptionPlaceholder'}}">{{system.description}}</textarea>
      {{else}}
      <p class="card-text">{{#if system.description}}{{system.description}}{{else}}—{{/if}}</p>
      {{/if}}
    </section>

    {{#if showPlace}}
    <section class="panel place-panel">
      <h2>{{localize "CANTICA.Place.Heading"}}</h2>
      {{#if isGM}}
      <div class="form-row">
        <label for="card-location-{{actor.id}}">{{localize "CANTICA.Place.PartOf"}}</label>
        <select id="card-location-{{actor.id}}" name="system.location">
          <option value="">{{localize "CANTICA.Place.NoLocation"}}</option>
          {{#each locationChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
        {{#if location}}<button type="button" data-action="openCard" data-id="{{location.id}}" title="{{localize 'CANTICA.Place.Open'}}"><i class="fa-solid fa-up-right-from-square"></i></button>{{/if}}
      </div>
      <p class="hint">{{localize "CANTICA.Place.PartOfHint"}}</p>
      <div class="form-row">
        <label for="card-links-{{actor.id}}">{{localize "CANTICA.Place.Links"}}</label>
        <input id="card-links-{{actor.id}}" type="text" name="system.links" value="{{system.links}}" placeholder="{{localize 'CANTICA.Place.LinksPlaceholder'}}" title="{{localize 'CANTICA.Place.LinksHint'}}">
      </div>
      {{else}}
      {{#if location}}<p class="note"><strong>{{localize "CANTICA.Place.PartOf"}}:</strong> <a data-action="openCard" data-id="{{location.id}}">{{locationPath}}</a></p>{{/if}}
      {{#if system.links}}<p class="note"><strong>{{localize "CANTICA.Place.Links"}}:</strong> {{system.links}}</p>{{/if}}
      {{/if}}
      {{#if sectionCards.length}}
      <p class="note"><strong>{{localize "CANTICA.Place.Sections"}}:</strong>
        {{#each sectionCards}}<a class="section-link" data-action="openCard" data-id="{{id}}" title="{{links}}">{{name}}</a>{{/each}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{#if isGM}}
    <section class="panel docket-panel">
      <h2>
        {{localize "CANTICA.Docket.Heading"}}
        {{#if docket.open}}
        <button type="button" class="add" data-action="closeDocket">{{localize "CANTICA.Docket.Close"}}</button>
        {{else}}
        <button type="button" class="add" data-action="openDocket">{{localize "CANTICA.Docket.Open"}}</button>
        {{/if}}
      </h2>
      <p class="hint">{{localize "CANTICA.Docket.Hint"}}</p>

      <div class="docket-fields">
        <label>{{localize "CANTICA.Docket.Job"}}<input type="text" name="system.docket.name" value="{{docket.name}}" placeholder="{{localize 'CANTICA.Docket.JobPlaceholder'}}"></label>
        <label>{{localize "CANTICA.Docket.Boxes"}}<input type="number" name="system.docket.boxes" value="{{docket.boxes}}" min="0"></label>
        <label>{{localize "CANTICA.Docket.Deadline"}}<input type="number" name="system.docket.deadline" value="{{docket.deadline}}" min="0"></label>
        <label>{{localize "CANTICA.Docket.Round"}}<input type="number" name="system.docket.round" value="{{docket.round}}" min="1"></label>
        <label>{{localize "CANTICA.Docket.Successes"}}<input type="number" name="system.docket.successes" value="{{docket.successes}}" min="0"></label>
      </div>

      <div class="docket-size">
        <span class="docket-size-label">{{localize "CANTICA.Docket.SizeFor"}}</span>
        <input type="number" id="docket-players" value="{{docket.players}}" min="1" max="8" aria-label="{{localize 'CANTICA.Docket.Players'}}">
        <span>{{localize "CANTICA.Docket.Players"}}</span>
        <button type="button" data-action="docketSize" data-level="routine">{{localize "CANTICA.Docket.Routine"}}</button>
        <button type="button" data-action="docketSize" data-level="standard">{{localize "CANTICA.Docket.Standard"}}</button>
        <button type="button" data-action="docketSize" data-level="hard">{{localize "CANTICA.Docket.Hard"}}</button>
      </div>

      {{#if docket.open}}
      <div class="docket-board docket-{{docket.status}}">
        <div class="docket-pips">{{#each docket.pips}}<i class="{{#if filled}}filled{{/if}}"></i>{{/each}}</div>
        <div class="docket-line">
          <strong>{{docket.filled}} / {{docket.boxes}}</strong> {{localize "CANTICA.Docket.Boxes"}}
          · {{localize "CANTICA.Docket.Round"}} {{docket.round}} / {{docket.deadline}}
          · <span class="docket-status">{{docket.statusLabel}}</span>
        </div>
        {{#if docket.outcomeLabel}}<p class="docket-outcome">{{docket.outcomeLabel}}</p>{{/if}}
        <div class="docket-controls">
          <button type="button" data-action="docketAdjust" data-delta="1">+1 {{localize "CANTICA.Docket.Success"}}</button>
          <button type="button" data-action="docketAdjust" data-delta="-1">−1</button>
          <button type="button" data-action="docketRound">{{localize "CANTICA.Docket.NextRound"}}</button>
          <button type="button" data-action="docketPush" title="{{localize 'CANTICA.Docket.PushHint'}}">{{localize "CANTICA.Docket.Push"}}</button>
        </div>
        <p class="hint">{{localize "CANTICA.Docket.CountHint"}}</p>
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if isGM}}
    <section class="panel proceedings-panel">
      <h2>
        {{localize "CANTICA.Proceedings.Heading"}}
        {{#if proceedings.open}}
        <button type="button" class="add" data-action="closeProceedings">{{localize "CANTICA.Proceedings.Close"}}</button>
        {{else}}
        <button type="button" class="add" data-action="openProceedings">{{localize "CANTICA.Proceedings.Open"}}</button>
        {{/if}}
      </h2>
      <p class="hint">{{localize "CANTICA.Proceedings.Hint"}}</p>
      <div class="docket-fields">
        <label>{{localize "CANTICA.Proceedings.Situation"}}<input type="text" name="system.proceedings.name" value="{{proceedings.name}}" placeholder="{{localize 'CANTICA.Proceedings.SituationPlaceholder'}}"></label>
        <label>{{localize "CANTICA.Npc.Rating"}}<input type="number" name="system.proceedings.rating" value="{{proceedings.rating}}" min="1" max="4"></label>
        <label>{{localize "CANTICA.Proceedings.Group"}}<input type="number" id="proceedings-group" name="system.proceedings.group" value="{{proceedings.group}}" min="1"></label>
      </div>
      {{#if proceedings.open}}
      <div class="docket-board docket-{{proceedings.status}}">
        <div class="docket-line"><strong>{{proceedings.approved}}</strong> {{localize "CANTICA.Proceedings.Approved"}} · {{proceedings.rolled}} / {{proceedings.group}} {{localize "CANTICA.Proceedings.Rolled"}} · <span class="docket-status">{{proceedings.statusLabel}}</span></div>
        <ul class="proceedings-results">
          {{#each proceedings.results}}
          <li><strong>{{who}}</strong> <span class="tier tier-{{tier}}">{{tierLabel}}</span> <span class="story">{{story}}</span>
            <button type="button" data-action="removeResult" data-who="{{who}}" title="{{localize 'CANTICA.Proceedings.Remove'}}"><i class="fa-solid fa-xmark"></i></button></li>
          {{else}}
          <li class="empty">{{localize "CANTICA.Proceedings.NoResults"}}</li>
          {{/each}}
        </ul>
        <p class="hint">{{localize "CANTICA.Proceedings.CountHint"}}</p>
      </div>
      {{/if}}
    </section>
    {{/if}}

    <section class="panel scene-traits-panel">
      <h2>
        {{localize "CANTICA.Card.Traits"}}
        {{#if isGM}}
        <button type="button" class="add" data-action="addTrait">{{localize "CANTICA.Card.AddTrait"}}</button>
        {{else}}
        <button type="button" class="add" data-action="amend" title="{{localize 'CANTICA.Card.AmendHint'}}">{{localize "CANTICA.Card.AmendButton"}}</button>
        {{/if}}
      </h2>
      <p class="hint">{{localize "CANTICA.Card.TraitsHint"}}</p>

      <ul class="trait-list">
        {{#each traits}}
        <li class="scene-trait">
          <details data-trait="{{id}}" {{#if open}}open{{/if}}>
            <summary>
              <span class="chip">◆</span>
              <span class="tname">{{#if name}}{{name}}{{else}}—{{/if}}</span>
            </summary>
            {{#if @root.isGM}}
            <div class="trait-edit">
              <input type="text" name="system.traits.{{index}}.name" value="{{name}}" placeholder="{{localize 'CANTICA.Card.TraitName'}}">
              <input type="text" name="system.traits.{{index}}.note" value="{{note}}" placeholder="{{localize 'CANTICA.Card.TraitNote'}}">
              <div class="trait-controls">
                <button type="button" data-action="deleteTrait" data-trait="{{id}}" title="{{localize 'CANTICA.Card.Delete'}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>
            {{else}}
            {{#if note}}<p class="note">{{note}}</p>{{else}}<p class="note">{{localize "CANTICA.Card.NoNote"}}</p>{{/if}}
            {{/if}}
          </details>
        </li>
        {{else}}
        <li class="empty">{{localize "CANTICA.Card.NoTraits"}}</li>
        {{/each}}
      </ul>
    </section>
  </div>
</div>
